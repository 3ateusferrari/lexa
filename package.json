{
  "name": "lexa",
  "version": "0.1.0",
  "private": true,
  "description": "Assistente RAG sobre legislação e editais brasileiros (Lei 14.133/2021 e LGPD)",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:web": "vite build --config web/vite.config.ts",
    "dev": "tsx watch src/modules/api/server.ts",
    "dev:worker": "tsx watch src/modules/worker/sqs-worker.ts",
    "start": "node dist/modules/api/server.js",
    "start:worker": "node dist/modules/worker/sqs-worker.js",
    "lint": "eslint --no-error-on-unmatched-pattern \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run src/",
    "test:integration": "vitest run tests/integration/",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:migrate:down": "tsx src/scripts/migrate.ts --down",
    "ingest:corpus": "tsx src/scripts/ingest-corpus.ts",
    "eval:seed": "tsx src/scripts/seed-eval-questions.ts",
    "eval:run": "tsx src/scripts/run-eval.ts",
    "eval:ci": "tsx src/scripts/eval-gate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/client-sqs": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@electric-sql/pglite": "^0.3.15",
    "@huggingface/transformers": "^3.3.3",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^10.18.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9.20.0",
    "prettier": "^3.5.1",
    "supertest": "^7.0.0",
    "testcontainers": "^10.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.4.5",
    "vitest": "^3.0.6"
  }
}
