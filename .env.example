# Banco de Dados PostgreSQL + pgvector
DATABASE_URL=postgresql://lexa:lexa_dev_password@localhost:5432/lexa_db

# Servidor HTTP
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Modelo Local de Embeddings (384 dimensões por padrão; determinístico ou Xenova/multilingual-e5-small)
LOCAL_EMBEDDING_MODEL=Xenova/multilingual-e5-small
EMBEDDING_DIMENSION=384
EMBEDDING_CACHE_DIR=.cache/embeddings

# Provedor LLM — Claude (Anthropic)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
ANTHROPIC_MODEL=claude-3-5-haiku-latest
MAX_DAILY_LLM_CALLS=200

# AWS / LocalStack (Ingestão Assíncrona S3 + SQS)
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_DOCUMENTS_BUCKET=lexa-documents
SQS_INGESTION_QUEUE_URL=http://localhost:4566/000000000000/lexa-ingestion-queue
SQS_INGESTION_DLQ_URL=http://localhost:4566/000000000000/lexa-ingestion-dlq
